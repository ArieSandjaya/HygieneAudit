################################################################################
# This .gitignore file was automatically created by Microsoft(R) Visual Studio.
################################################################################

# Build output (never commit — leaks secrets baked into appsettings copies)
bin/
obj/
.vs/
# NuGet restore target — vendored DLLs live under BackEnd/libs/ instead
packages/

# Node / npm (tooling only, not part of the project)
node_modules/
package.json
package-lock.json
/BackEnd/WebApps/appsettings.Production.json
/BackEnd/WebApps/appsettings.json
/BackEnd/WebApps/Web.config
/BackEnd/WebApps/Web.Debug.config
# Semua Web.config di subfolder Views (konfigurasi Razor view engine, tidak perlu di-commit)
BackEnd/**/Views/Web.config
# Web.Release.config dikecualikan dari ignore agar template placeholder bisa di-commit.
# Jangan commit setelah Anda mengisi kredensial SQL Server yang sebenarnya.

# Uploaded photos — disimpan di App_Data (di luar pemantauan FileChangesMonitor,
# otomatis diblokir IIS dari akses HTTP). Tidak di-commit, tahan re-publish.
/BackEnd/WebApps/App_Data/Uploads/*
!/BackEnd/WebApps/App_Data/Uploads/.gitkeep

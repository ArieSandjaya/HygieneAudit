@{
    ViewBag.Title = "Pengaturan Notifikasi";
}

<div id="notif-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h4 class="fw-bold mb-1">Notifikasi Email Follow Up</h4>
            <p class="text-muted mb-0">Kirim pengingat otomatis saat tanggal follow up temuan sudah tiba</p>
        </div>
        <a href="@Url.Action("Index", "Users")" class="btn btn-outline-secondary">
            <i class="bx bx-group me-1"></i> Atur Penerima
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Status & jadwal -->
            <div class="card mb-4">
                <div class="card-header"><h5 class="card-title mb-0">Jadwal Pengiriman</h5></div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="nEnabled" data-bind="checked: f.enabled" />
                        <label class="form-check-label fw-semibold" for="nEnabled">Aktifkan notifikasi email otomatis</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Jam kirim (jam server)</label>
                            <input type="time" class="form-control" data-bind="value: f.sendTime" />
                            <small class="text-muted">Dikirim sekali per hari setelah jam ini.</small>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Alamat dasar aplikasi (opsional)</label>
                            <input type="text" class="form-control" maxlength="256" placeholder="https://hygiene.perusahaan.com" data-bind="value: f.baseUrl" />
                            <small class="text-muted">Dipakai untuk tautan ke halaman Follow Up di dalam email.</small>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="nOverdue" data-bind="checked: f.includeOverdue" />
                                <label class="form-check-label" for="nOverdue">Sertakan temuan yang sudah lewat tanggal follow up dan belum Pass (diingatkan setiap hari)</label>
                            </div>
                            <small class="text-muted">Bila dimatikan, hanya temuan yang tanggal follow up-nya tepat hari ini.</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SMTP -->
            <div class="card mb-4">
                <div class="card-header"><h5 class="card-title mb-0">Server SMTP</h5></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Host SMTP</label>
                            <input type="text" class="form-control" maxlength="256" placeholder="smtp.perusahaan.com" data-bind="value: f.smtpHost" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Port</label>
                            <input type="number" class="form-control" min="1" max="65535" data-bind="value: f.smtpPort" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="nSsl" data-bind="checked: f.useSsl" />
                                <label class="form-check-label" for="nSsl">SSL/TLS</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input type="text" class="form-control" maxlength="256" autocomplete="off" data-bind="value: f.smtpUsername" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" autocomplete="new-password" placeholder="••••••••" data-bind="value: f.smtpPassword, disable: f.clearPassword" />
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted" data-bind="text: passwordHint"></small>
                                <div class="form-check mb-0" data-bind="visible: hasPassword">
                                    <input class="form-check-input" type="checkbox" id="nClear" data-bind="checked: f.clearPassword" />
                                    <label class="form-check-label small" for="nClear">Hapus</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Alamat pengirim</label>
                            <input type="email" class="form-control" maxlength="256" placeholder="noreply@perusahaan.com" data-bind="value: f.fromAddress" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nama pengirim (opsional)</label>
                            <input type="text" class="form-control" maxlength="128" placeholder="Hygiene Audit" data-bind="value: f.fromName" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button class="btn btn-primary" data-bind="click: save, disable: saving() || loading()">
                            <span data-bind="visible: saving"><i class="bx bx-loader-circle bx-spin me-1"></i> Menyimpan...</span>
                            <span data-bind="visible: !saving()"><i class="bx bx-check me-1"></i> Simpan Pengaturan</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header"><h5 class="card-title mb-0">Status</h5></div>
                <div class="card-body">
                    <div class="mb-2"><span class="text-muted">Penerima aktif:</span>
                        <strong data-bind="text: recipientCount"></strong>
                        <small class="d-block text-muted">Pengguna aktif dengan email dan opsi notifikasi dicentang di menu Pengguna.</small>
                    </div>
                    <div class="mb-2"><span class="text-muted">Pengiriman terakhir:</span>
                        <strong data-bind="text: lastRunText"></strong>
                    </div>
                    <div class="small" data-bind="visible: lastRunMessage, text: lastRunMessage"></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="card-title mb-0">Uji &amp; Kirim</h5></div>
                <div class="card-body">
                    <label class="form-label">Kirim email uji ke</label>
                    <div class="input-group mb-2">
                        <input type="email" class="form-control" placeholder="nama@perusahaan.com" data-bind="value: testTo" />
                        <button class="btn btn-outline-primary" data-bind="click: sendTest, disable: testing">
                            <span data-bind="visible: testing"><i class="bx bx-loader-circle bx-spin"></i></span>
                            <span data-bind="visible: !testing()">Tes</span>
                        </button>
                    </div>
                    <small class="text-muted d-block mb-3">Memakai pengaturan yang sudah disimpan.</small>
                    <button class="btn btn-outline-warning w-100" data-bind="click: runNow, disable: running">
                        <span data-bind="visible: running"><i class="bx bx-loader-circle bx-spin me-1"></i> Mengirim...</span>
                        <span data-bind="visible: !running()"><i class="bx bx-send me-1"></i> Kirim Pengingat Sekarang</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/knockout-3.5.0.js"></script>
    <script src="@Asset.V("~/Scripts/app/notificationsettings.viewmodel.js")"></script>
    <script>ko.applyBindings(new NotificationSettingsViewModel(), document.getElementById('notif-page'));</script>
}

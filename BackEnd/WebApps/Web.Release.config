<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.Release.config – diterapkan otomatis saat Publish dengan konfigurasi Release.
  Ubah nilai connection string sesuai SQL Server production Anda.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <!--
      Ganti nilai di bawah sesuai SQL Server production:
        Data Source  = nama server / IP  (contoh: localhost, .\SQLEXPRESS, 192.168.1.10)
        Initial Catalog = nama database   (biarkan HygieneAuditDb atau sesuaikan)
        User ID / Password = login SQL Server
        — ATAU —
        Hapus User ID & Password, ganti dengan Integrated Security=True  (Windows Auth)
    -->
    <add name="HygieneAuditConnection"
         connectionString="Data Source=NAMA_SERVER;Initial Catalog=HygieneAuditDb;User ID=USERNAME;Password=PASSWORD;MultipleActiveResultSets=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <!-- Matikan debug mode di production (wajib untuk performa & bundling) -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!--
      customErrors mode="RemoteOnly"  → pengguna remote lihat halaman error generik,
      tapi Anda bisa lihat detail error saat akses dari server itu sendiri.
      Ganti ke mode="Off" sementara jika ingin lihat detail error dari browser mana pun.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error" xdt:Transform="Insert" />
  </system.web>

</configuration>

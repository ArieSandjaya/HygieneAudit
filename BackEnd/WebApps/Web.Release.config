<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.Release.config – diterapkan otomatis saat Publish dengan konfigurasi Release.
  Ubah nilai connection string sesuai SQL Server production Anda.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <!--
      Ganti nilai di bawah sesuai SQL Server production:
        Data Source  = nama server / IP  (contoh: localhost, .\SQLEXPRESS, 192.168.1.10)
        Initial Catalog = nama database   (biarkan HygieneAuditDb atau sesuaikan)
        User ID / Password = login SQL Server
        — ATAU —
        Hapus User ID & Password, ganti dengan Integrated Security=True  (Windows Auth)
    -->
    <add name="HygieneAuditConnection"
         connectionString="Data Source=NAMA_SERVER;Initial Catalog=HygieneAuditDb;User ID=USERNAME;Password=PASSWORD;MultipleActiveResultSets=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <!-- Matikan debug mode di production (wajib untuk performa & bundling) -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- SetAttributes mengubah atribut pada elemen <customErrors> yang sudah ada di Web.config -->
    <customErrors mode="Off" xdt:Transform="SetAttributes" />

    <!-- Izinkan request hingga 32 MB, dan matikan File Change Notification
         (fcnMode="Disabled") agar penyimpanan foto upload tidak pernah memicu
         recycle AppDomain. Setelah deploy Web.config/binari baru, recycle App
         Pool secara manual. -->
    <httpRuntime maxRequestLength="32768" executionTimeout="120" fcnMode="Disabled"
                 xdt:Transform="SetAttributes" />

  </system.web>

  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 33554432 bytes = 32 MB, harus konsisten dengan maxRequestLength di atas -->
        <requestLimits maxAllowedContentLength="33554432"
                       xdt:Transform="SetAttributes" />
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Catatan: foto disimpan di luar folder aplikasi (default %ProgramData%\HygieneAudit\Uploads,
       bisa di-override via appSetting "PhotoUploadPath"). Karena di luar web root, file tidak
       bisa diakses via HTTP langsung — hanya lewat /api/audits/photos/{id} yang terautentikasi.
       Menyimpan di luar app root juga mencegah ASP.NET FileChangesMonitor me-recycle AppDomain
       (yang menghentikan debugger) setiap kali foto baru disimpan.
       Pastikan identity App Pool punya izin Modify pada folder tujuan (sekali setup di server). -->

</configuration>
